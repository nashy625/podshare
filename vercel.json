{
  "installCommand": "npm install",
  "buildCommand": "npm run prisma:generate && npm run build --workspace @podshare/shared && npm run build --workspace frontend",
  "outputDirectory": "apps/frontend/dist",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
